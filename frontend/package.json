{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run i18n:check",
    "test": "ng test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/noto-kufi-arabic": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard-scss": "18.0.0",
    "stylelint-declaration-strict-value": "1.13.0",
    "stylelint-plugin-logical-css": "2.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  }
}
