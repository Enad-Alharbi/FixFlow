# Copy this file to .env (git-ignored) and replace the placeholder values.
#   Copy-Item .env.example .env

# SQL Server "sa" password for the local database container.
# Rules: at least 8 characters with 3 of: uppercase, lowercase, digit, symbol.
# Avoid $ ; " ' and spaces: they break Compose interpolation or the connection string.
MSSQL_SA_PASSWORD=Change-Me-Strong-Passw0rd

# Secret key that signs the API's access tokens (JWTs). At least 32 random bytes, base64.
# Anyone with this key can mint tokens for any user, so it never leaves .env. Generate one with:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SIGNING_KEY=replace-with-a-generated-key

# Development only: password shared by all demo accounts (admin, acme.*, nahda.*) created on startup.
# Must meet the password rules (8+ chars, upper, lower, digit, special). Leave empty to skip the demo data.
SEED_DEMO_PASSWORD=Demo-Change-Me-1
